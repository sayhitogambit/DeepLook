# Local use needs no API key. The CLI does not automatically load this file.
# Optional local Chrome override:
# DEEPLOOK_CHROME=/absolute/path/to/google-chrome

# Optional remote API you operate. Supply your own browser key privately.
# DEEPLOOK_API_URL=https://your-api.example
# DEEPLOOK_API_TOKEN=<your-own-browser-key>

# No SMTP or LLM credentials are required by the local browser.
