{
  "name": "deeplook",
  "version": "0.1.0",
  "private": true,
  "description": "Agent browser CLI that opens one public URL and returns the page text.",
  "type": "module",
  "bin": {
    "deeplook": "./dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "!dist/*.test.js",
    "README*.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "docs/*.md",
    "docs/assets/readme-banner-v1/deeplook-readme-*-v1.png",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/*.test.js",
    "test:browser": "tsc && DEEPLOOK_TEST_BROWSER=1 node --test dist/browser.integration.test.js",
    "test:package": "tsc && DEEPLOOK_TEST_PACKAGE=1 node --test dist/package.integration.test.js",
    "prepack": "npm run build",
    "open": "node dist/cli.js"
  },
  "engines": {
    "node": ">=22.14"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "playwright-core": "1.56.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "author": "DeepLook contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayhitogambit/DeepLook.git"
  },
  "homepage": "https://github.com/sayhitogambit/DeepLook#readme",
  "bugs": {
    "url": "https://github.com/sayhitogambit/DeepLook/issues"
  }
}
